# Copy to .env (gitignored) or use the dashboard's Connect page, which writes this file for you.
# Agents never see these: tools read them through Settings.secret().

# Required: the signing key for logins and links (>= 32 random chars). `bizops init-secret` writes one.
# Never change it once emails are out: unsubscribe links are signed with it.
BIZOPS_SECRET=

# Model access: nothing needed if this machine is logged in to Claude Code. On a server, use:
ANTHROPIC_API_KEY=                # an API key: the supported route for an always-on server
CLAUDE_CODE_OAUTH_TOKEN=          # subscription token from `claude setup-token`: check Anthropic's terms
                                  # before running it on a 24/7 server

# Owner login for the dashboard (or run `bizops set-password`)
BIZOPS_PASSWORD=
PUBLIC_BASE_URL=                  # e.g. https://yourapp.fly.dev (set automatically on Fly)

# Get paid: one Stripe account for the whole umbrella (restricted key recommended)
STRIPE_SECRET_KEY=

# Email (a mailbox on your domain)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
EMAIL_FROM=
SENDER_NAME=                      # legal sender name (CAN-SPAM)
SENDER_ADDRESS=                   # postal address (CAN-SPAM)

# Let agents buy tools and subscriptions: one Privacy.com virtual card per CIO-approved purchase
PRIVACY_API_KEY=
PRIVACY_SANDBOX=                  # 1 for a Privacy.com sandbox key
CARDHOLDER_NAME=                  # typed into checkout forms with the card
CARDHOLDER_ZIP=

# Optional
VAPI_API_KEY=                     # phone agents
BRAVE_API_KEY=                    # web search provider
TYPESAFE_API_KEY=                 # Jev (TypeSafe): cheaper, faster decisions + quality scoring
BIZOPS_PAYMENTS_PROVIDER=sandbox  # outgoing payments to vendors
