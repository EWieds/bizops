# Copy to .env (gitignored). Agents never see these: tools read them through Settings.secret().

# Model calls (live mode). Without it, use `bizops serve --dry-run`.
ANTHROPIC_API_KEY=

# Optional: Brave Search API for web_search (otherwise Anthropic's server-side web search is used).
BRAVE_API_KEY=

# Optional: Jev decision model as an approver step (TypeSafe AI). Leave empty to skip.
JEV_API_URL=
JEV_API_KEY=

# Payments provider: sandbox (default, moves no real money).
BIZOPS_PAYMENTS_PROVIDER=sandbox

# Paths (defaults shown)
# BIZOPS_DB=data/bizops.db
# BIZOPS_DATA_DIR=data
